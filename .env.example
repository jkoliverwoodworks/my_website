# Set to the final public origin before a domain launch. Do not include a path.
# Git-backed website studio. All credentials stay server-side.
STUDIO_GITHUB_OWNER=
STUDIO_GITHUB_REPO=
# Must match the hosting provider's production branch.
STUDIO_GITHUB_BRANCH=
# Fine-grained GitHub token: only this repository, Contents read/write.
STUDIO_GITHUB_TOKEN=
# Generated from a strong password; never store the plaintext password.
STUDIO_PASSWORD_HASH=
# Random value with at least 32 characters.
STUDIO_SESSION_SECRET=
# Exact production HTTPS origin, no trailing slash.
STUDIO_SITE_ORIGIN=

NEXT_PUBLIC_SITE_URL=https://jk-oliver-woodworks.andres-urreg-3756.chatgpt.site

# --- Moil Email Gateway ----------------------------------------------------
# Base origin of the gateway. No trailing slash.
EMAIL_GATEWAY_URL=https://mail.moilapp.com

# This application's API key, issued by the gateway admin
# (POST /admin/applications). Shown once at creation — treat it as a secret.
EMAIL_GATEWAY_API_KEY=xxxx

# --- SMTP relay ------------------------------------------------------------
# Credentials for the mailbox the gateway sends *as*, passed inline with each
# send. For Gmail this is an App Password (https://myaccount.google.com/apppasswords),
# NOT the account password; 2-Step Verification must be on.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=cs@moilapp.com
# The 16-character App Password. Spaces are stripped, so either form works.
SMTP_PASSWORD=xxx
# starttls (default, port 587) | tls (port 465) | none (rejected for non-loopback hosts)
SMTP_ENCRYPTION=starttls

# --- Addressing ------------------------------------------------------------
# Mailbox the gateway sends from (the gateway's `from`). Defaults to SMTP_USERNAME.
MAIL_FROM=cs@moilapp.com
# Address recipients see (the gateway's `from_alias`). Must be a verified
# "Send mail as" alias on the MAIL_FROM mailbox.
MAIL_FROM_ALIAS=jeremyoliver@att.net
# Optional display name on the From header.
MAIL_FROM_NAME=J. K. Oliver Website
# Where inquiry / appointment requests are delivered.
MAIL_TO=jeremyoliver@att.net
